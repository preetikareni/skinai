<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>SkinAI – Skin analysis and care recommendations</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --rose:#e8cfc8;--blush:#f4e8e4;--cream:#fbf5f2;--petal:#d9b4a8;
  --plum:#3d2622;--muted:#8a6f69;--sage:#9ea48a;--gold:#b88f55;
  --line:rgba(61,38,34,.12);--shadow:0 24px 60px rgba(120,70,60,.16);
  --serif:'Cormorant Garamond',Georgia,serif;--sans:'Jost',system-ui,sans-serif;
}
html{scroll-behavior:smooth;}
body{font-family:var(--sans);color:var(--plum);min-height:100vh;overflow-x:hidden;
  background:radial-gradient(1200px 700px at 12% 8%,#f1d9d1 0,transparent 60%),
             radial-gradient(900px 700px at 92% 90%,#e3c2b7 0,transparent 60%),#ead5ce;}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;}

/* Ambient petals */
.petal{position:fixed;z-index:0;pointer-events:none;border-radius:60% 40% 55% 45%/55% 45% 60% 40%;
  background:radial-gradient(circle at 30% 30%,#fbefea,#e3bfb3 70%);opacity:.55;filter:blur(1px);
  animation:drift 26s ease-in-out infinite alternate;}
.p1{width:420px;height:380px;top:-120px;left:-140px;}
.p2{width:320px;height:300px;bottom:-110px;left:6%;animation-delay:-9s;opacity:.45;}
.p3{width:460px;height:420px;top:30%;right:-190px;animation-delay:-14s;}
.p4{width:220px;height:200px;top:8%;right:14%;opacity:.3;animation-delay:-5s;}
@keyframes drift{to{transform:translate(40px,30px) rotate(14deg) scale(1.06);}}

.shell{position:relative;z-index:1;max-width:1240px;margin:28px auto;padding:0 20px;}
.panel{background:rgba(251,245,242,.82);backdrop-filter:blur(18px);border-radius:32px;box-shadow:var(--shadow);border:1px solid rgba(255,255,255,.6);}

/* Header */
header{display:flex;align-items:center;justify-content:space-between;padding:26px 48px;}
.logo{font-family:var(--serif);font-size:28px;font-weight:600;letter-spacing:.01em;}
.logo i{font-weight:400;color:var(--gold);}
.status-pill{display:flex;align-items:center;gap:8px;padding:8px 18px;border-radius:999px;font-size:13px;background:var(--cream);border:1px solid var(--line);color:var(--muted);}
.dot{width:8px;height:8px;border-radius:50%;background:var(--sage);}
.ready .dot{animation:pulse 2.4s ease-in-out infinite;}
.not-ready .dot{background:#c0675a;}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(158,164,138,.6);}50%{box-shadow:0 0 0 7px rgba(158,164,138,0);}}

/* Hero */
.hero{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:40px;padding:36px 48px 64px;}
.hero h1{font-family:var(--serif);font-weight:500;font-size:clamp(42px,6vw,78px);line-height:1.02;letter-spacing:-.01em;margin-bottom:26px;}
.hero h1 .ln{display:block;overflow:hidden;padding-bottom:.08em;}
.hero h1 .ln span{display:inline-block;transform:translateY(105%);animation:rise 1.1s cubic-bezier(.2,.8,.2,1) forwards;}
.hero h1 .ln:nth-child(2) span{animation-delay:.14s;font-style:italic;color:var(--gold);}
.hero h1 .ln:nth-child(3) span{animation-delay:.28s;}
@keyframes rise{to{transform:none;}}
.hero p{color:var(--muted);font-size:17px;line-height:1.7;max-width:460px;margin-bottom:34px;opacity:0;animation:fade 1s .7s forwards;}
@keyframes fade{to{opacity:1;}}
.cta{display:inline-block;padding:15px 36px;border-radius:999px;background:var(--cream);border:1px solid var(--line);color:var(--plum);font:500 14px var(--sans);letter-spacing:.04em;text-decoration:none;cursor:pointer;transition:background .3s,color .3s,transform .3s;opacity:0;animation:fade 1s .9s forwards;}
.cta:hover{background:var(--plum);color:var(--cream);transform:translateY(-2px);}

/* Arch frame */
.arch{position:relative;justify-self:center;width:min(100%,380px);aspect-ratio:3/4;border-radius:190px 190px 28px 28px;overflow:hidden;
  background:radial-gradient(circle at 35% 25%,#fff3ee,#e7c3b8 55%,#c99a8d);box-shadow:var(--shadow);
  clip-path:inset(100% 0 0 0 round 190px 190px 28px 28px);animation:unveil 1.5s .2s cubic-bezier(.2,.8,.2,1) forwards;}
@keyframes unveil{to{clip-path:inset(0 0 0 0 round 190px 190px 28px 28px);}}
.arch .bloom{position:absolute;border-radius:60% 40% 55% 45%/55% 45% 60% 40%;background:radial-gradient(circle at 30% 30%,#fffaf7,#efd0c6 70%);animation:bloom 12s ease-in-out infinite alternate;}
.arch .b1{width:70%;height:55%;top:12%;left:14%;}
.arch .b2{width:48%;height:40%;top:38%;left:40%;opacity:.8;animation-delay:-4s;}
.arch .b3{width:34%;height:30%;top:50%;left:12%;opacity:.7;animation-delay:-8s;background:radial-gradient(circle at 30% 30%,#e9ecde,#9ea48a);}
@keyframes bloom{to{transform:rotate(18deg) scale(1.12) translate(6px,-8px);}}
.arch .tag{z-index:2;position:absolute;left:50%;bottom:22px;transform:translateX(-50%);padding:10px 22px;border-radius:999px;background:rgba(251,245,242,.9);font-size:13px;color:var(--plum);white-space:nowrap;}

/* Hero portrait image */
.girl-image{
  position:absolute;
  z-index:1;
  inset:0;
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center bottom;
  filter:drop-shadow(0 16px 24px rgba(90,50,42,.12));
  animation:portraitFloat 6s ease-in-out infinite;
}
@keyframes portraitFloat{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-5px);}
}

/* Original SVG animation styles retained for compatibility if needed */
.girl{position:absolute;inset:0;width:100%;height:100%;}
.girl .breathe{animation:breathe 5s ease-in-out infinite;}
@keyframes breathe{50%{transform:translateY(4px);}}
.girl .hair{transform-origin:150px 40px;animation:sway 7s ease-in-out infinite alternate;}
@keyframes sway{from{transform:rotate(-1.1deg);}to{transform:rotate(1.1deg);}}
.girl .flower{animation:flower 6s ease-in-out infinite alternate;}
@keyframes flower{from{transform:rotate(-7deg) scale(1);}to{transform:rotate(7deg) scale(1.06);}}
.girl .lid{transform-box:fill-box;transform-origin:50% 0;transform:scaleY(0);animation:blink 5.5s infinite;}
@keyframes blink{0%,92%,100%{transform:scaleY(0);}95%{transform:scaleY(1);}}
.girl .fp{animation:fall 11s linear infinite;opacity:0;}
.girl .f2{animation-duration:14s;animation-delay:-5s;}
.girl .f3{animation-duration:12s;animation-delay:-9s;}
@keyframes fall{0%{transform:translate(0,-20px) rotate(0);opacity:0;}10%{opacity:.9;}90%{opacity:.9;}100%{transform:translate(40px,420px) rotate(220deg);opacity:0;}}

/* Upload */
.section{padding:0 48px 64px;}
.section-title{font-family:var(--serif);font-size:38px;font-weight:500;text-align:center;margin-bottom:8px;}
.section-sub{color:var(--muted);text-align:center;margin-bottom:32px;}
.upload-zone{max-width:640px;margin:0 auto;border:1.5px dashed rgba(184,143,85,.55);border-radius:28px;padding:44px 24px;text-align:center;background:rgba(244,232,228,.5);transition:background .3s,border-color .3s,transform .3s;}
.upload-zone:hover,.upload-zone.drag{background:rgba(244,232,228,.95);border-color:var(--gold);transform:scale(1.01);}
.upload-icon{font-size:44px;display:block;margin-bottom:12px;}
.upload-zone h3{font-family:var(--serif);font-size:26px;font-weight:500;margin-bottom:6px;}
.upload-zone p{color:var(--muted);font-size:14px;}
#fileInput{display:none;}
.browse-btn{display:inline-block;margin-top:20px;padding:12px 30px;border-radius:999px;background:var(--plum);color:var(--cream);font-weight:500;font-size:14px;cursor:pointer;transition:background .3s;}
.browse-btn:hover{background:var(--gold);}
.preview-wrap{display:none;margin-top:24px;}
.preview-wrap img{max-height:220px;max-width:100%;border-radius:20px;box-shadow:var(--shadow);}
.analyze-btn{display:none;margin:26px auto 0;padding:15px 44px;border:none;border-radius:999px;background:linear-gradient(135deg,var(--gold),#cfa56a);color:#fff;font:500 15px var(--sans);letter-spacing:.03em;cursor:pointer;box-shadow:0 10px 28px rgba(184,143,85,.4);transition:transform .3s,box-shadow .3s;}
.analyze-btn:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(184,143,85,.5);}
.analyze-btn:disabled{opacity:.5;cursor:not-allowed;transform:none;}
.error-box{display:none;margin-top:18px;padding:14px 18px;border-radius:14px;background:#f6dcd6;color:#8f3b30;font-size:14px;}
.warn-banner{max-width:640px;margin:0 auto 28px;padding:14px 20px;border-radius:16px;background:#f3e6c8;color:#7a5a1d;font-size:14px;text-align:center;}

/* Loader */
#loader{display:none;text-align:center;padding:20px 0 56px;}
.spinner{width:54px;height:54px;margin:0 auto 16px;border-radius:60% 40% 55% 45%/55% 45% 60% 40%;background:radial-gradient(circle at 30% 30%,#fff3ee,var(--petal));animation:spin 1.6s linear infinite;}
@keyframes spin{to{transform:rotate(360deg) scale(1.1);}}
#loader p{color:var(--muted);}

/* Results */
#results{display:none;padding:0 48px 64px;}
.reset-btn{display:block;margin:0 auto 28px;padding:10px 26px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--muted);font:400 14px var(--sans);cursor:pointer;transition:all .3s;}
.reset-btn:hover{background:var(--plum);color:var(--cream);}
.result-header{display:flex;align-items:center;gap:28px;padding:28px 32px;border-radius:28px;background:linear-gradient(135deg,#f6e4de,#efd4cb);margin-bottom:22px;}
.result-img{width:104px;height:128px;object-fit:cover;border-radius:52px 52px 16px 16px;box-shadow:var(--shadow);}
.result-label{font-size:14px;color:var(--muted);margin-bottom:2px;}
.result-condition{font-family:var(--serif);font-size:46px;font-weight:500;line-height:1.1;text-transform:capitalize;}
.confidence-bar{height:6px;border-radius:3px;background:rgba(61,38,34,.12);overflow:hidden;margin-top:12px;}
.confidence-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--sage),var(--gold));transition:width 1.2s cubic-bezier(.2,.8,.2,1);}
.confidence-text{font-size:13px;color:var(--muted);margin-top:6px;}
.skin-desc{font-family:var(--serif);font-size:21px;line-height:1.6;color:var(--plum);padding:6px 8px 26px;max-width:760px;}
.skin-desc strong{font-weight:600;font-style:italic;color:var(--gold);}
.prob-section{padding:26px 30px;border-radius:24px;background:var(--cream);border:1px solid var(--line);margin-bottom:34px;}
.prob-section h3{font-family:var(--serif);font-size:24px;font-weight:500;margin-bottom:18px;}
.prob-row{margin-bottom:14px;}
.prob-label{display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px;}
.prob-bar-bg{height:6px;border-radius:3px;background:rgba(61,38,34,.08);overflow:hidden;}
.prob-bar-fill{height:100%;border-radius:3px;transition:width 1.3s cubic-bezier(.2,.8,.2,1);}
.reco-title{font-family:var(--serif);font-size:32px;font-weight:500;margin-bottom:18px;}
.reco-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;}
.reco-card{padding:26px;background:var(--cream);border:1px solid var(--line);border-radius:26px 26px 26px 6px;transition:transform .35s,box-shadow .35s;}
.reco-card:nth-child(even){border-radius:26px 26px 6px 26px;background:#f6e9e4;}
.reco-card:hover{transform:translateY(-5px);box-shadow:var(--shadow);}
.reco-card-title{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:23px;font-weight:600;margin-bottom:12px;}
.reco-list{list-style:none;}
.reco-list li{font-size:14.5px;color:#5c4540;padding:8px 0;border-bottom:1px solid var(--line);display:flex;gap:10px;line-height:1.55;}
.reco-list li:last-child{border-bottom:none;}
.reco-list li::before{content:"";flex-shrink:0;width:6px;height:6px;margin-top:9px;border-radius:50%;background:var(--gold);}

footer{text-align:center;padding:30px 20px 10px;color:var(--muted);font-size:13px;position:relative;z-index:1;}

@media(max-width:860px){
  header{padding:20px 24px;}
  .hero{grid-template-columns:1fr;padding:20px 24px 48px;text-align:center;}
  .hero p{margin-inline:auto;}
  .section,#results{padding-inline:20px;}
  .result-header{flex-direction:column;text-align:center;}
}
@media(prefers-reduced-motion:reduce){
  *,*::before{animation:none!important;transition:none!important;}
  .hero h1 .ln span,.hero p,.cta{transform:none;opacity:1;}
  .arch{clip-path:none;}
}
</style>
</head>
<body>

<div class="petal p1"></div><div class="petal p2"></div><div class="petal p3"></div><div class="petal p4"></div>

<div class="shell">
  <div class="panel">
    <header>
      <div class="logo">Skin<i>AI</i></div>
    </header>

    <section class="hero">
      <div>
        <h1>
          <span class="ln"><span>Know your skin,</span></span>
          <span class="ln"><span>care for it</span></span>
          <span class="ln"><span>naturally.</span></span>
        </h1>
        <p>Upload a clear photo and our deep learning model detects your skin condition, then suggests a skincare routine, foods, and daily habits that suit it.</p>
        <a class="cta" href="#upload">Analyze my skin</a>
      </div>
      <div class="arch" aria-hidden="true">
        <img
          class="girl-image"
          src="{{ url_for('static', filename='images/hero-girl.png') }}"
          alt="Skincare beauty portrait"
        />
        <div class="tag">Gentle, personalized care</div>
      </div>
    </section>

    <section class="section" id="upload">
      <h2 class="section-title">Upload your photo</h2>
      <p class="section-sub">Natural light and a clean face give the best results.</p>

      <div class="upload-zone" id="uploadZone">
        <span class="upload-icon">🌸</span>
        <h3>Drop your skin photo here</h3>
        <p>JPG, PNG or WEBP. A clear, well-lit face or skin area works best.</p>
        <label class="browse-btn" for="fileInput">Choose a photo</label>
        <input type="file" id="fileInput" accept="image/*"/>
        <div class="preview-wrap" id="previewWrap">
          <img id="previewImg" src="" alt="Preview of your photo"/>
        </div>
        <div class="error-box" id="uploadError"></div>
      </div>
      <div style="text-align:center;">
        <button class="analyze-btn" id="analyzeBtn" onclick="analyzeImage()">Analyze my skin</button>
      </div>
    </section>

    <div id="loader">
      <div class="spinner"></div>
      <p>Analyzing your skin…</p>
    </div>

    <section id="results">
      <button class="reset-btn" onclick="resetAll()">Analyze another photo</button>

      <div class="result-header">
        <img id="resImg" class="result-img" src="" alt=""/>
        <div style="flex:1;">
          <div class="result-label">Detected condition</div>
          <div class="result-condition"><span id="resIcon" style="font-size:34px;margin-right:8px;"></span><span id="resCondition"></span></div>
          <div class="confidence-bar"><div class="confidence-fill" id="confFill" style="width:0%"></div></div>
          <div class="confidence-text" id="confText"></div>
        </div>
      </div>

      <div class="skin-desc" id="skinDesc"></div>

      <div class="prob-section">
        <h3>Confidence breakdown</h3>
        <div id="probBars"></div>
      </div>

      <div class="reco-title">Your personalized recommendations</div>
      <div class="reco-grid" id="recoGrid"></div>
    </section>
  </div>

  <footer>
    SkinAI &nbsp;•&nbsp; For educational purposes only. Not a substitute for medical advice. &nbsp;•&nbsp; © 2026
  </footer>
</div>

<script>
let selectedFile = null;

const zone = document.getElementById('uploadZone');
const fileInput = document.getElementById('fileInput');
const previewWrap = document.getElementById('previewWrap');
const previewImg = document.getElementById('previewImg');
const analyzeBtn = document.getElementById('analyzeBtn');
const uploadError = document.getElementById('uploadError');

zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag'); });
zone.addEventListener('dragleave', () => zone.classList.remove('drag'));
zone.addEventListener('drop', e => {
  e.preventDefault(); zone.classList.remove('drag');
  const f = e.dataTransfer.files[0];
  if (f && f.type.startsWith('image/')) loadFile(f);
});
fileInput.addEventListener('change', () => { if (fileInput.files[0]) loadFile(fileInput.files[0]); });

function loadFile(file) {
  selectedFile = file;
  const reader = new FileReader();
  reader.onload = e => {
    previewImg.src = e.target.result;
    previewWrap.style.display = 'block';
    analyzeBtn.style.display = 'inline-block';
    uploadError.style.display = 'none';
  };
  reader.readAsDataURL(file);
}

async function analyzeImage() {
  if (!selectedFile) return;
  analyzeBtn.disabled = true;
  document.getElementById('loader').style.display = 'block';
  document.getElementById('results').style.display = 'none';
  uploadError.style.display = 'none';

  const form = new FormData();
  form.append('image', selectedFile);

  try {
    const res = await fetch('/analyze', { method: 'POST', body: form });
    const data = await res.json();
    if (!data.success) { showError(data.error || 'Something went wrong. Please try again.'); return; }
    showResults(data);
  } catch (err) {
    showError('Network error: ' + err.message);
  } finally {
    analyzeBtn.disabled = false;
    document.getElementById('loader').style.display = 'none';
  }
}

function showError(msg) {
  uploadError.textContent = msg;
  uploadError.style.display = 'block';
}

const COLORS = ['#b88f55','#9ea48a','#d9a89a','#8a6f69','#cfb7a8'];
const cap = s => s.charAt(0).toUpperCase() + s.slice(1);

function showResults(data) {
  document.getElementById('results').style.display = 'block';
  document.getElementById('resImg').src = data.image_data;
  document.getElementById('resCondition').textContent = cap(data.label);
  document.getElementById('resIcon').textContent = data.recommendations.icon || '🌸';

  document.getElementById('confFill').style.width = '0%';
  setTimeout(() => { document.getElementById('confFill').style.width = data.confidence + '%'; }, 100);
  document.getElementById('confText').textContent = `Confidence: ${data.confidence}%`;

  document.getElementById('skinDesc').innerHTML =
    `<strong>About ${cap(data.label)} skin:</strong> ${data.recommendations.description || ''}`;

  const probBars = document.getElementById('probBars');
  probBars.innerHTML = '';
  let i = 0;
  for (const [cls, prob] of Object.entries(data.all_probs).sort((a,b) => b[1]-a[1])) {
    probBars.innerHTML += `
      <div class="prob-row">
        <div class="prob-label"><span>${cap(cls)}</span><span>${prob}%</span></div>
        <div class="prob-bar-bg"><div class="prob-bar-fill" style="width:0%;background:${COLORS[i%COLORS.length]}" data-w="${prob}"></div></div>
      </div>`;
    i++;
  }
  setTimeout(() => {
    document.querySelectorAll('.prob-bar-fill').forEach(b => b.style.width = b.dataset.w + '%');
  }, 150);

  const recoGrid = document.getElementById('recoGrid');
  recoGrid.innerHTML = '';
  const reco = data.recommendations;
  const sections = [
    {key:'skincare', title:'Skincare routine', icon:'🧴'},
    {key:'food',     title:'Diet and nutrition', icon:'🥗'},
    {key:'tips',     title:'Lifestyle tips', icon:'🌿'},
    {key:'products', title:'Recommended products', icon:'✨'},
  ];
  sections.forEach(s => {
    if (!reco[s.key] || !reco[s.key].length) return;
    recoGrid.innerHTML += `
      <div class="reco-card">
        <div class="reco-card-title"><span>${s.icon}</span>${s.title}</div>
        <ul class="reco-list">${reco[s.key].map(item => `<li>${item}</li>`).join('')}</ul>
      </div>`;
  });

  document.getElementById('results').scrollIntoView({behavior:'smooth', block:'start'});
}

function resetAll() {
  selectedFile = null;
  fileInput.value = '';
  previewImg.src = '';
  previewWrap.style.display = 'none';
  analyzeBtn.style.display = 'none';
  uploadError.style.display = 'none';
  document.getElementById('results').style.display = 'none';
  document.getElementById('loader').style.display = 'none';
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>
</body>
</html>